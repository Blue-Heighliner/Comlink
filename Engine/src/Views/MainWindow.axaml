<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BlueHeighliner.Comlink.Engine.ViewModels"
        xmlns:controls="using:BlueHeighliner.Comlink.Engine.Views.Controls"
        xmlns:installViews="using:BlueHeighliner.Comlink.Engine.Views.Install"
        x:Class="BlueHeighliner.Comlink.Engine.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="500"
        SystemDecorations="None"
        Background="#1E1E1E"
        TransparencyLevelHint="None"
        WindowState="Maximized">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Environment Banner (row 0) -->
    <controls:EnvironmentBanner Grid.Row="0"
                                Title="{Binding EnvironmentTitle}"
                                BannerColor="{Binding EnvironmentColor}"
                                IsVisible="{Binding EnvironmentTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <!-- Custom Title Bar (row 1) - always shown; Server mode swaps the left-side drafts/notes/export/
         import/print action buttons for the right-side CONNECTIONS/ACTIVITY view switcher (see IsServerMode) -->
    <controls:TitleBar Grid.Row="1"
                       UserName="{Binding UserName}"
                       AppVersion="{Binding AppVersion}"
                       CreateDraftCommand="{Binding CreateDraftCommand}"
                       CreateNoteCommand="{Binding CreateNoteCommand}"
                       ShowExportCommand="{Binding ShowExportCommand}"
                       ShowImportCommand="{Binding ShowImportCommand}"
                       ShowPrintManagerCommand="{Binding ShowPrintManagerCommand}"
                       IsInstallScreenVisible="{Binding IsInstallScreenVisible}"
                       IsServerMode="{Binding IsServerMode}"
                       ShowConnectionsCommand="{Binding ShowConnectionsCommand}"
                       ShowActivityCommand="{Binding ShowActivityCommand}"
                       IsKioskMode="{Binding IsKioskMode}"
                       IsAlerting="{Binding Alert.IsAlerting}"
                       AlertText="{Binding Alert.AlertText}"
                       QuickConfirmationEnabled="{Binding Alert.QuickConfirmationEnabled}"
                       AlertCommand="{Binding Alert.ConfirmLatestCommand}" />

    <!-- Main Content (row 2) -->
    <Panel Grid.Row="2">

      <!-- Install Screen -->
      <installViews:InstallView DataContext="{Binding InstallView}"
                                IsVisible="{Binding $parent[Window].DataContext.IsInstallScreenVisible}" />

      <!-- Main 3-panel layout: inbox/outbox/notes/drafts UI, never shown in Server mode -->
      <Grid IsVisible="{Binding ShowMainLayout}"
            ColumnDefinitions="220,4,300,4,*">

        <!-- Folder Bar -->
        <controls:FolderBar Grid.Column="0"
                            DataContext="{Binding FolderBar}" />

        <!-- Splitter 1 -->
        <GridSplitter Grid.Column="1"
                      ResizeDirection="Columns"
                      Background="#3E3E42"
                      MinWidth="2" />

        <!-- Entry Bar -->
        <controls:EntryBar Grid.Column="2"
                           DataContext="{Binding EntryBar}" />

        <!-- Splitter 2 -->
        <GridSplitter Grid.Column="3"
                      ResizeDirection="Columns"
                      Background="#3E3E42"
                      MinWidth="2" />

        <!-- Content Area -->
        <controls:ContentArea Grid.Column="4"
                              DataContext="{Binding ContentArea}" />
      </Grid>

      <!-- Server mode: two connections tables replace the normal layout — a routing-only server has no
           inbox/outbox/notes/drafts of its own. Each table is hidden outright while it has no rows
           (e.g. no other servers configured, or no children configured). -->
      <StackPanel IsVisible="{Binding ShowConnectionsTable}" Margin="24,20" Spacing="24">

        <!-- Server connections: other servers in the cluster this instance dials out to. -->
        <DockPanel IsVisible="{Binding ConnectionStatus.HasServerRows}">
          <TextBlock DockPanel.Dock="Top"
                     Text="SERVERS"
                     FontSize="11" FontWeight="SemiBold" Foreground="#858585" LetterSpacing="1"
                     Margin="0,0,0,12" />

          <ItemsControl ItemsSource="{Binding ConnectionStatus.ServerRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ConnectionRowViewModel}">
                <controls:ConnectionRow DataContext="{Binding}" Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>

        <!-- Client connections: this server's own configured child clients. -->
        <DockPanel IsVisible="{Binding ConnectionStatus.HasClientRows}">
          <TextBlock DockPanel.Dock="Top"
                     Text="CLIENTS"
                     FontSize="11" FontWeight="SemiBold" Foreground="#858585" LetterSpacing="1"
                     Margin="0,0,0,12" />

          <ItemsControl ItemsSource="{Binding ConnectionStatus.ClientRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ConnectionRowViewModel}">
                <controls:ConnectionRow DataContext="{Binding}" Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </StackPanel>

      <!-- Server mode: activity log view, switched to via the title bar's ACTIVITY button — the same
           EntryBar/ContentArea pairing peer/client mode shows for the Activity folder, without a folder
           bar (a routing-only server has no other folders worth navigating to). -->
      <Grid IsVisible="{Binding ShowServerActivityView}"
            ColumnDefinitions="300,4,*">

        <controls:EntryBar Grid.Column="0"
                           DataContext="{Binding EntryBar}" />

        <GridSplitter Grid.Column="1"
                      ResizeDirection="Columns"
                      Background="#3E3E42"
                      MinWidth="2" />

        <controls:ContentArea Grid.Column="2"
                              DataContext="{Binding ContentArea}" />
      </Grid>
    </Panel>

    <!-- Client mode: a single row tracking the connection to the configured server, pinned to the bottom
         of the window, visually matching a row in Server mode's connections tables. -->
    <controls:ConnectionRow Grid.Row="3"
                            IsVisible="{Binding $parent[Window].DataContext.IsClientMode}"
                            DataContext="{Binding ConnectionStatus.ServerRows[0]}" />

  </Grid>
</Window>
