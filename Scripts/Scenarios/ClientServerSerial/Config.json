{
  "AuthorityCertificate": "../Root.cer",
  "CertificateStore": "../ClientServer",
  "Users": {
    "SERVER": {
      "Role": "Server",
      "IpHost": "127.0.0.1",
      "Msmt": { "Port": 50321 },
      "InterfacePort": 50320,
      "Hdlc": { "Address": 1, "Ports": [ "ttyUSB3" ] },
      "Children": [
        { "User": "CLIENT1", "Mode": "Hdlc" },
        "CLIENT2"
      ],
      "SecurityLevel": "RESTRICTED"
    },
    "CLIENT1": {
      "Role": "Client",
      "InterfacePort": 50322,
      "Hdlc": { "Address": 2, "Ports": [ "ttyUSB0" ] },
      "Parent": { "User": "SERVER", "Mode": "Hdlc" },
      "SecurityLevel": "INTERNAL"
    },
    "CLIENT2": {
      "Role": "Client",
      "InterfacePort": 50324,
      "Parent": "SERVER",
      "SecurityLevel": "INTERNAL"
    }
  }
}
