root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4

# File-scoped namespaces everywhere.
csharp_style_namespace_declarations = file_scoped:error

# Always use braces for blocks - never an implicit one-line if/else/for/foreach/while.
csharp_prefer_braces = true:error

# Do not use var. Always declare the explicit type.
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = false:error
csharp_style_var_elsewhere = false:error

# Use target-typed new() to avoid repeating an already-stated type.
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion

# Prefer expression-bodied members over full block bodies when possible and practical.
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion
csharp_style_expression_bodied_operators = when_on_single_line:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# Prefer primary constructors when possible.
csharp_style_prefer_primary_constructors = true:suggestion

[*.{cs,csx}]
# Private const fields (fixed values, e.g. P/Invoke native constant names): PascalCase - listed before
# the general instance-field rule below since Roslyn applies the first matching rule in file order, and
# these are otherwise per-instance camelCase fields. `static readonly` fields are not included here since
# they cover both constant-like values (PascalCase) and shared mutable-looking instances like test
# fixtures (camelCase) - too mixed a convention to enforce mechanically, so they fall through to the
# general rule below like any other field.
dotnet_naming_rule.private_constant_fields_pascal_case.severity = warning
dotnet_naming_rule.private_constant_fields_pascal_case.symbols = private_constant_fields
dotnet_naming_rule.private_constant_fields_pascal_case.style = pascal_case

dotnet_naming_symbols.private_constant_fields.applicable_kinds = field
dotnet_naming_symbols.private_constant_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_constant_fields.required_modifiers = const

# Private fields: plain camelCase, no leading underscore (e.g. `engineController`, not `_engineController`).
dotnet_naming_rule.private_fields_camel_case.severity = warning
dotnet_naming_rule.private_fields_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_camel_case.style = camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.camel_case.capitalization = camel_case

# Public/internal members: PascalCase (e.g. `EngineController`).
dotnet_naming_rule.public_members_pascal_case.severity = warning
dotnet_naming_rule.public_members_pascal_case.symbols = public_members
dotnet_naming_rule.public_members_pascal_case.style = pascal_case

dotnet_naming_symbols.public_members.applicable_kinds = class, struct, interface, enum, property, method, event, delegate
dotnet_naming_symbols.public_members.applicable_accessibilities = public, internal, protected, protected_internal, private_protected

dotnet_naming_style.pascal_case.capitalization = pascal_case
