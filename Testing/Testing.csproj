<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RootNamespace>BlueHeighliner.Comlink.Testing</RootNamespace>
    <AssemblyName>BlueHeighliner.Comlink.Testing</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>BlueHeighliner.Comlink.Testing</PackageId>
    <Authors>Chris Markwardt</Authors>
    <Description>Mocks of every context the Comlink engine hands to a host's handlers and of every service it offers, for unit testing custom handler types and components without running the engine.</Description>
    <PackageTags>comlink;messaging;testing;mocks;moq</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Blue-Heighliner/Comlink</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Blue-Heighliner/Comlink</PackageProjectUrl>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
