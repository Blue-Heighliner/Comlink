script
	cd Sample
	run dotnet publish -r linux-x64
	run dotnet publish -r win-x64
	cd ..
	folder Build overwrite
	move Sample/bin/Release/net10.0/linux-x64/publish/BlueHeighliner.Comlink.Sample -> Build/Linux
	move Sample/bin/Release/net10.0/win-x64/publish/BlueHeighliner.Comlink.Sample.exe -> Build/Windows
	rename Build/Linux/BlueHeighliner.Comlink.Sample -> Sample
	rename Build/Windows/BlueHeighliner.Comlink.Sample.exe -> Sample.exe