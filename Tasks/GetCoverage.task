var RAW_DIR = TestResults/Coverage/Raw
var REPORT_DIR = TestResults/Coverage/Report

script Get Coverage
	run dotnet tool restore
	run
		rm -rf %RAW_DIR%
		dotnet test Tests/Tests.csproj --settings Tests/coverage.runsettings "--collect:XPlat Code Coverage" --results-directory %RAW_DIR%
	run
		COVERAGE_FILE=$(find %RAW_DIR% -name "coverage.cobertura.xml" | head -1)
		dotnet reportgenerator "-reports:$COVERAGE_FILE" "-targetdir:%REPORT_DIR%" -reporttypes:TextSummary
		cat %REPORT_DIR%/Summary.txt
