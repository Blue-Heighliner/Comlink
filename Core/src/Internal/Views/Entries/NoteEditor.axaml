<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BlueHeighliner.Comlink"
             x:Class="BlueHeighliner.Comlink.NoteEditor"
             x:DataType="vm:NoteViewModel"
             Background="#1E1E1E">

  <DockPanel Margin="24,20">

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top"
            BorderBrush="#3E3E42"
            BorderThickness="0,0,0,1"
            Padding="0,0,0,10"
            Margin="0,0,0,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusMessage}"
                     FontSize="12"
                     Foreground="#858585"
                     VerticalAlignment="Center" />
          <Button Classes="neutral"
                  Content="DUPLICATE"
                  Command="{Binding DuplicateCommand}" />
          <Button Classes="negative" Content="{Binding DeleteButtonText}"
                  Command="{Binding DeleteCommand}"
                  IsVisible="{Binding CanDelete}" />
          <Button Classes="positive"
                  Content="SAVE"
                  Command="{Binding SaveCommand}"
                  IsEnabled="{Binding !IsSaving}" />
        </StackPanel>
        <TextBlock Text="{vm:Display 'NOTE'}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="#858585"
                   LetterSpacing="1"
                   VerticalAlignment="Center"
                   Margin="0,0,14,0" />
        <TextBox Text="{Binding Name}"
                 Watermark="Name"
                 Width="140"
                 HorizontalAlignment="Left"
                 Background="#3C3C3C"
                 BorderThickness="0"
                 FontSize="12"
                 Height="30" />
      </DockPanel>
    </Border>

    <!-- Note Body (fills remaining space) -->
    <TextBox Classes="plain"
             Text="{Binding Body}"
             Watermark="Start writing..."
             AcceptsReturn="True"
             TextWrapping="Wrap"
             FontSize="14"
             Background="Transparent"
             BorderThickness="0"
             Padding="0"
             LineHeight="24"
             VerticalContentAlignment="Top"
             VerticalAlignment="Stretch" />

  </DockPanel>
</UserControl>
