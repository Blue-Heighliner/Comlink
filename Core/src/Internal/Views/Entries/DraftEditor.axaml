<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BlueHeighliner.Comlink.ViewModels.Entries"
             xmlns:converters="using:BlueHeighliner.Comlink.ViewModels"
             xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="BlueHeighliner.Comlink.Views.Entries.DraftEditor"
             x:DataType="vm:DraftViewModel"
             Background="#1E1E1E">

  <DockPanel Margin="24,20">

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top"
            BorderBrush="#3E3E42"
            BorderThickness="0,0,0,1"
            Padding="0,0,0,10"
            Margin="0,0,0,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusMessage}"
                     FontSize="12"
                     Foreground="#858585"
                     VerticalAlignment="Center" />
          <TextBox Text="{Binding Tag}"
                   Watermark="{Binding TagLabel}"
                   Width="90"
                   Background="#3C3C3C"
                   BorderThickness="0"
                   FontSize="12"
                   Height="26"
                   VerticalAlignment="Center">
            <TextBox.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="!IsSent" />
                <Binding Path="TagsEnabled" />
              </MultiBinding>
            </TextBox.IsVisible>
          </TextBox>
          <ComboBox ItemsSource="{Binding AvailablePriorities}"
                    SelectedItem="{Binding SelectedPriority}"
                    IsVisible="{Binding !IsSent}"
                    Background="#3C3C3C"
                    BorderThickness="0"
                    FontSize="12"
                    Height="26"
                    VerticalAlignment="Center">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox ItemsSource="{Binding AvailableSecurityLevels}"
                    SelectedItem="{Binding SelectedSecurityLevel}"
                    Background="#3C3C3C"
                    BorderThickness="0"
                    FontSize="12"
                    Height="26"
                    VerticalAlignment="Center">
            <ComboBox.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="!IsSent" />
                <Binding Path="SelectedSecurityLevel" Converter="{x:Static ObjectConverters.IsNotNull}" />
              </MultiBinding>
            </ComboBox.IsVisible>
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <CheckBox Content="{Binding AlertLabel}"
                     IsChecked="{Binding IsAlert}"
                     Foreground="#E06C75"
                     FontSize="12"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center">
            <CheckBox.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="!IsSent" />
                <Binding Path="ComposeAlertsEnabled" />
              </MultiBinding>
            </CheckBox.IsVisible>
          </CheckBox>
          <Button Content="{Binding DeleteButtonText}"
                  Command="{Binding DeleteCommand}"
                  IsVisible="{Binding CanDelete}"
                  Foreground="#E06C75"
                  FontWeight="SemiBold"
                  FontSize="12" />
          <Button Classes="accent"
                  Content="SAVE"
                  Command="{Binding SaveCommand}"
                  IsEnabled="{Binding !IsSaving}"
                  FontWeight="SemiBold"
                  FontSize="12" />
          <Button Classes="accent"
                  Content="SEND"
                  Command="{Binding SendCommand}"
                  IsEnabled="{Binding !IsSaving}"
                  FontWeight="SemiBold"
                  FontSize="12"
                  IsVisible="{Binding !IsSent}"
                  Background="#1565C0" />
          <TextBlock Text="SENT"
                     IsVisible="{Binding IsSent}"
                     Foreground="#4CAF50"
                     FontSize="12"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <TextBlock Text="DRAFT"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="#858585"
                     LetterSpacing="1"
                     VerticalAlignment="Center" />
          <Button x:Name="AddFillInButton"
                  Content="FILL-IN"
                  IsVisible="{Binding !IsSent}"
                  Click="OnAddFillInClick"
                  FontSize="11"
                  FontWeight="SemiBold"
                  Foreground="#858585"
                  Padding="8,4"
                  Margin="0,0,8,0" />
          <Button x:Name="PlsoButton"
                  Content="{Binding PlsoButtonText}"
                  IsVisible="{Binding !IsSent}"
                  Click="OnPlsoButtonClick"
                  ToolTip.Tip="Phonetic Language Spell Out — click to cycle OFF → ON → SPACES. ON replaces typed letters/digits with their phonetic word (A → ALFA, 5 → FIVE); SPACES does the same and adds a trailing space after each word."
                  FontSize="11"
                  FontWeight="SemiBold"
                  Foreground="#858585"
                  Padding="8,4" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Addresses -->
    <Border DockPanel.Dock="Top"
            BorderBrush="#3E3E42"
            BorderThickness="0,0,0,1"
            Margin="0,0,0,12"
            Padding="0,0,0,12">
      <StackPanel Spacing="6">

        <!-- Existing addresses -->
        <ItemsControl ItemsSource="{Binding Addresses}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="70,Auto,*,Auto" Margin="0,2">
                <Border Grid.Column="0"
                        Background="#3C3C3C"
                        CornerRadius="3"
                        Padding="6,2"
                        HorizontalAlignment="Left">
                  <TextBlock FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="#858585">
                    <TextBlock.Text>
                      <MultiBinding Converter="{x:Static converters:AddressTypeLabelConverter.Instance}">
                        <Binding Path="Type" />
                        <Binding Path="$parent[UserControl].DataContext.AddressTypes" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding UserName}"
                           FontSize="13"
                           Foreground="#CCCCCC"
                           VerticalAlignment="Center"
                           Margin="8,0" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Information}"
                           IsVisible="{Binding Information, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           FontSize="13"
                           FontStyle="Italic"
                           Foreground="#858585"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="3"
                        Content="×"
                        Command="{Binding $parent[UserControl].DataContext.RemoveAddressCommand}"
                        CommandParameter="{Binding}"
                        IsVisible="{Binding $parent[UserControl].DataContext.IsSent, Converter={x:Static BoolConverters.Not}}"
                        FontSize="14"
                        Padding="4,0"
                        Foreground="#858585" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Add address row -->
        <Grid ColumnDefinitions="90,*,*,Auto"
              IsVisible="{Binding !IsSent}"
              Margin="0,4,0,0">
          <ComboBox Grid.Column="0"
                    ItemsSource="{Binding AddressTypes}"
                    SelectedItem="{Binding NewAddressType}"
                    Background="#3C3C3C"
                    BorderThickness="0"
                    FontSize="12"
                    Height="30">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <AutoCompleteBox Grid.Column="1"
                           x:Name="UserInput"
                           Text="{Binding NewAddressUser}"
                           Watermark="User name..."
                           ItemsSource="{Binding AllUserNames}"
                           FilterMode="StartsWith"
                           MinimumPrefixLength="1"
                           FontSize="13"
                           Margin="8,0"
                           Height="30" />
          <TextBox Grid.Column="2"
                   Text="{Binding NewAddressInformation}"
                   Watermark="Information..."
                   FontSize="13"
                   Height="30">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding AddAddressCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="3"
                  Content="Add"
                  Margin="8,0,0,0"
                  Command="{Binding AddAddressCommand}"
                  Padding="10,4"
                  FontSize="12" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- Body: single AvaloniaEdit TextEditor with fill-ins as inline objects (fills remaining space) -->
    <avaloniaEdit:TextEditor x:Name="BodyEditor"
                             IsReadOnly="{Binding IsSent}"
                             FontFamily="avares://BlueHeighliner.Comlink/Assets/Fonts/DejaVuSansMono.ttf#DejaVu Sans Mono"
                             FontSize="16"
                             WordWrap="True"
                             ShowLineNumbers="False"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalScrollBarVisibility="Auto" />

  </DockPanel>
</UserControl>
