<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BlueHeighliner.Comlink"
             x:Class="BlueHeighliner.Comlink.EntryBar"
             x:DataType="vm:EntryBarViewModel"
             Background="#252526"
             BorderBrush="#3E3E42"
             BorderThickness="1,0,1,0"
             MinWidth="200">

  <DockPanel>

    <!-- Pagination Header -->
    <Border DockPanel.Dock="Top"
            BorderBrush="#3E3E42"
            BorderThickness="0,0,0,1"
            Padding="8,4">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Grid.Column="0"
                Content="&lt; Prev"
                Command="{Binding PrevPageCommand}"
                IsEnabled="{Binding CanGoPrev}"
                FontSize="13"
                Padding="6,2" />
        <TextBlock Grid.Column="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="13"
                   Foreground="#858585">
          <TextBlock.Text>
            <MultiBinding StringFormat="{}{0} / {1}">
              <Binding Path="CurrentPage" />
              <Binding Path="TotalPages" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
        <Button Grid.Column="2"
                Content="Next &gt;"
                Command="{Binding NextPageCommand}"
                IsEnabled="{Binding CanGoNext}"
                FontSize="13"
                Padding="6,2" />
      </Grid>
    </Border>

    <!-- Search and filters (hidden for Activity, which has no free-text fields worth searching) -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding ShowSearch}"
            BorderBrush="#3E3E42"
            BorderThickness="0,0,0,1"
            Padding="8,4">
      <StackPanel Spacing="6">
        <!-- Filters toggle header - collapsed by default; collapsing only hides the controls below, it never
             clears them, so search keeps running against whatever this section last filtered to. -->
        <Button Command="{Binding ToggleFiltersCommand}"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Cursor="Hand">
          <Grid ColumnDefinitions="16,*,16">
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <TextBlock Text="FILTERS"
                         FontSize="11"
                         Foreground="#5A5A5A"
                         FontWeight="SemiBold"
                         LetterSpacing="1"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding ActiveFilterCount, StringFormat='{}{0} active'}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="#98C379"
                         VerticalAlignment="Center"
                         IsVisible="{Binding HasActiveFilters}" />
            </StackPanel>
            <TextBlock Grid.Column="2"
                       Text="{Binding FiltersExpandIndicator}"
                       FontSize="10"
                       Foreground="#5A5A5A"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right" />
          </Grid>
        </Button>

        <!-- Search, date range, message level, priority and alert-only (shown when the section above is
             expanded). Each control gets its own full-width row rather than sharing one, since a
             DatePicker/TimePicker's segmented layout does not shrink to fit and gets cut off when squeezed into
             a narrower column. -->
        <StackPanel IsVisible="{Binding IsFiltersExpanded}" Spacing="10">
          <TextBox Text="{Binding SearchText}"
                   Watermark="Search..."
                   Background="#3C3C3C"
                   BorderThickness="0"
                   FontSize="13"
                   Height="28" />
          <StackPanel Spacing="3">
            <TextBlock Text="FROM" FontSize="10" Foreground="#5A5A5A" FontWeight="SemiBold" LetterSpacing="1" />
            <DatePicker SelectedDate="{Binding DateFrom}" FontSize="12" HorizontalAlignment="Stretch" />
            <TimePicker SelectedTime="{Binding TimeFrom}" FontSize="12" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Spacing="3">
            <TextBlock Text="TO" FontSize="10" Foreground="#5A5A5A" FontWeight="SemiBold" LetterSpacing="1" />
            <DatePicker SelectedDate="{Binding DateTo}" FontSize="12" HorizontalAlignment="Stretch" />
            <TimePicker SelectedTime="{Binding TimeTo}" FontSize="12" HorizontalAlignment="Stretch" />
          </StackPanel>

          <StackPanel Spacing="3" IsVisible="{Binding ShowAuthorFilter}">
            <TextBlock Text="AUTHOR" FontSize="10" Foreground="#5A5A5A" FontWeight="SemiBold" LetterSpacing="1" />
            <TextBox Text="{Binding AuthorFilter}"
                     Watermark="Sender name..."
                     Background="#3C3C3C"
                     BorderThickness="0"
                     FontSize="12"
                     Height="26" />
          </StackPanel>

          <StackPanel Spacing="3" IsVisible="{Binding ShowDestinationFilter}">
            <TextBlock Text="DESTINATION" FontSize="10" Foreground="#5A5A5A" FontWeight="SemiBold" LetterSpacing="1" />
            <TextBox Text="{Binding DestinationFilter}"
                     Watermark="Recipient name..."
                     Background="#3C3C3C"
                     BorderThickness="0"
                     FontSize="12"
                     Height="26" />
          </StackPanel>

          <StackPanel Spacing="3" IsVisible="{Binding ShowMessageLevelFilter}">
            <TextBlock Text="{vm:Display 'MESSAGE LEVEL'}" FontSize="10" Foreground="#5A5A5A" FontWeight="SemiBold" LetterSpacing="1" />
            <ComboBox ItemsSource="{Binding AvailableMessageLevelFilters}"
                      SelectedItem="{Binding SelectedMessageLevelFilter}"
                      Background="#3C3C3C"
                      BorderThickness="0"
                      FontSize="12"
                      Height="26"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="3" IsVisible="{Binding ShowPriorityFilter}">
            <TextBlock Text="{vm:Display 'PRIORITY'}" FontSize="10" Foreground="#5A5A5A" FontWeight="SemiBold" LetterSpacing="1" />
            <ComboBox ItemsSource="{Binding AvailablePriorityFilters}"
                      SelectedItem="{Binding SelectedPriorityFilter}"
                      Background="#3C3C3C"
                      BorderThickness="0"
                      FontSize="12"
                      Height="26"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <CheckBox Content="{vm:Display 'Alert only'}"
                    IsChecked="{Binding AlertOnlyFilter}"
                    IsVisible="{Binding ShowAlertFilter}"
                    Foreground="#CCCCCC"
                    FontSize="12" />

          <Button Content="RESET FILTERS"
                  Command="{Binding ResetFiltersCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Background="#3C3C3C"
                  Foreground="#CCCCCC"
                  BorderThickness="0"
                  FontSize="11"
                  FontWeight="SemiBold"
                  Padding="0,6" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Sort toggle header (Drafts/Notes only) -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding ShowSortToggle}"
            BorderBrush="#3E3E42"
            BorderThickness="0,0,0,1"
            Padding="8,4">
      <Button Content="{Binding IsAlphabeticalSort, Converter={x:Static vm:SortLabelValueConverter.Instance}}"
              Command="{Binding ToggleSortCommand}"
              Background="Transparent"
              Foreground="#858585"
              FontSize="11"
              Padding="4,2"
              HorizontalAlignment="Center" />
    </Border>

    <!-- Entry List -->
    <ListBox x:Name="EntryList"
             ItemsSource="{Binding Entries}"
             SelectedItem="{Binding SelectedEntry, Mode=OneWay}"
             SelectionMode="Multiple"
             SelectionChanged="OnEntrySelectionChanged"
             Background="Transparent"
             BorderThickness="0">

      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:EntryItemViewModel}">
          <DockPanel Margin="0,2">
            <Border DockPanel.Dock="Top"
                    Height="3"
                    Margin="0,0,0,4"
                    Background="{Binding MessageLevelColorHex, Converter={x:Static vm:ColorHexToBrushConverter.Instance}}"
                    IsVisible="{Binding MessageLevelColorHex, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Grid ColumnDefinitions="*,Auto" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Print"
                            Command="{Binding $parent[Window].DataContext.PrintEntryCommand}"
                            CommandParameter="{Binding}" />
                  <MenuItem Header="Delete"
                            Command="{Binding $parent[UserControl].DataContext.DeleteCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding $parent[UserControl].DataContext.CanDeleteEntries}" />
                </ContextMenu>
              </Grid.ContextMenu>
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="{Binding Title}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{Binding TitleColorHex, Converter={x:Static vm:ColorHexToBrushConverter.Instance}}"
                           ToolTip.Tip="{Binding Title}" />
                <TextBlock Text="{Binding SecondaryText}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{Binding SecondaryTextColorHex, Converter={x:Static vm:ColorHexToBrushConverter.Instance}}"
                           IsVisible="{Binding SecondaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <StackPanel Orientation="Horizontal"
                            Spacing="6"
                            IsVisible="{Binding PriorityText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding PriorityText}"
                             FontSize="11"
                             TextTrimming="CharacterEllipsis"
                             Foreground="#858585" />
                  <TextBlock Text="{Binding TagText}"
                             FontSize="11"
                             TextTrimming="CharacterEllipsis"
                             Foreground="#858585"
                             IsVisible="{Binding TagText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="{Binding TimeText}"
                           FontSize="11"
                           Foreground="#858585"
                           HorizontalAlignment="Right"
                           IsVisible="{Binding TimeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding StatusText}"
                           FontSize="11"
                           Foreground="{Binding StatusColorHex, Converter={x:Static vm:ColorHexToBrushConverter.Instance}}"
                           HorizontalAlignment="Right"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Grid>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>

    </ListBox>

  </DockPanel>
</UserControl>
