<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BlueHeighliner.Comlink"
             xmlns:entryVm="using:BlueHeighliner.Comlink"
             xmlns:entryViews="using:BlueHeighliner.Comlink"
             xmlns:views="using:BlueHeighliner.Comlink"
             x:Class="BlueHeighliner.Comlink.ContentArea"
             x:DataType="vm:ContentAreaViewModel"
             Background="#1E1E1E">

  <Panel>

    <!-- Home screen -->
    <TextBlock Text="{Binding HomeText}"
               IsVisible="{Binding IsHomeVisible}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               FontSize="18"
               Foreground="#5A5A5A"
               TextAlignment="Center"
               Margin="40" />

    <!-- Active entry content -->
    <ContentControl Content="{Binding ActiveContent}"
                    IsVisible="{Binding !IsHomeVisible}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
      <ContentControl.DataTemplates>

        <DataTemplate DataType="{x:Type entryVm:MessageViewModel}">
          <entryViews:MessageView DataContext="{Binding}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type entryVm:DraftViewModel}">
          <entryViews:DraftEditor DataContext="{Binding}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type entryVm:NoteViewModel}">
          <entryViews:NoteEditor DataContext="{Binding}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type entryVm:ActivityLogViewModel}">
          <entryViews:ActivityLogView DataContext="{Binding}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ExportViewModel}">
          <views:ExportView DataContext="{Binding}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ImportViewModel}">
          <views:ImportView DataContext="{Binding}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StagedSendViewModel}">
          <views:StagedSendView DataContext="{Binding}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RetrieveViewModel}">
          <views:RetrieveView DataContext="{Binding}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AutoForwardViewModel}">
          <views:AutoForwardView DataContext="{Binding}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PrintManagerViewModel}">
          <views:PrintManagerView DataContext="{Binding}" />
        </DataTemplate>

      </ContentControl.DataTemplates>
    </ContentControl>

  </Panel>
</UserControl>
