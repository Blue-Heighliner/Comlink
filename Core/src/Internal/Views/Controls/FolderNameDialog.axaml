<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BlueHeighliner.Comlink.FolderNameDialog"
        Title="New Folder"
        Width="280"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#2D2D30">

    <Border BorderBrush="#3E3E42" BorderThickness="1">
        <StackPanel Margin="16,14" Spacing="12">
            <TextBox x:Name="NameBox"
                     Watermark="Folder name"
                     FontSize="13" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="neutral" x:Name="CancelBtn"
                        Content="Cancel" />
                <Button Classes="positive" x:Name="OkBtn"
                        Content="Create" />
            </StackPanel>
        </StackPanel>
    </Border>

</Window>
