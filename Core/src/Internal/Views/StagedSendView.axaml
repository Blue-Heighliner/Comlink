<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BlueHeighliner.Comlink.ViewModels"
             x:Class="BlueHeighliner.Comlink.Views.StagedSendView"
             x:DataType="vm:StagedSendViewModel"
             Background="#1E1E1E">

  <DockPanel Margin="24,20">

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top"
            BorderBrush="#3E3E42"
            BorderThickness="0,0,0,1"
            Padding="0,0,0,10"
            Margin="0,0,0,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusMessage}"
                     FontSize="12"
                     Foreground="#858585"
                     VerticalAlignment="Center" />
          <Button Content="CLEAR"
                  Command="{Binding ClearCommand}"
                  FontSize="12" />
          <Button Classes="accent"
                  Content="SEND ALL"
                  Command="{Binding SendAllCommand}"
                  FontSize="12"
                  FontWeight="SemiBold" />
          <Button Content="×"
                  Command="{Binding $parent[Window].DataContext.ShowHomeCommand}"
                  ToolTip.Tip="Close"
                  FontSize="16"
                  Padding="8,0"
                  Foreground="#858585" />
        </StackPanel>
        <TextBlock Text="STAGED SEND"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="#858585"
                   LetterSpacing="1"
                   VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <ProgressBar DockPanel.Dock="Top"
                 IsIndeterminate="True"
                 IsVisible="{Binding IsSending}"
                 Height="4"
                 Margin="0,0,0,16" />

    <!-- Queue -->
    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <TextBlock Text="MESSAGES" FontSize="11" FontWeight="SemiBold" Foreground="#858585" LetterSpacing="1" />
      <TextBlock Text="No staged sends yet"
                 IsVisible="{Binding !HasQueue}"
                 FontSize="12"
                 Foreground="#858585" />
      <ItemsControl ItemsSource="{Binding Queue}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:StagedSendEntry}">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
              <Border Grid.Column="0"
                      Background="#3C3C3C"
                      CornerRadius="3"
                      Padding="6,2"
                      Margin="0,0,8,0"
                      HorizontalAlignment="Left">
                <TextBlock Text="{Binding Status}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#CCCCCC" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock Text="{Binding Subject}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Subject}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           FontSize="11"
                           Foreground="#C62828" />
              </StackPanel>
              <Button Grid.Column="2"
                      Content="×"
                      Command="{Binding $parent[UserControl].DataContext.RemoveCommand}"
                      CommandParameter="{Binding}"
                      FontSize="14"
                      Padding="4,0"
                      Foreground="#858585" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

  </DockPanel>
</UserControl>
